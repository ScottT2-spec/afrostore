# ─── Database ────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/postgres"

# ─── Authentication ──────────────────────────────────────────
JWT_SECRET="change-this-to-a-random-secret"

# 64-character hex string (32 bytes) used to encrypt sensitive profile
# fields (bank account numbers, tax IDs, government ID numbers) at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required — without it, encryption/decryption of those fields fails.
PROFILE_ENCRYPTION_KEY=""

# ─── App URLs ────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL="https://yourdomain.com"
NEXT_PUBLIC_APP_DOMAIN="yourdomain.com"
NEXT_PUBLIC_API_URL="https://yourdomain.com"

# ─── File Storage (AWS S3) ────────────────────────────────────
# Read by src/lib/s3-storage.ts (media/file uploads). Migrated off
# Supabase Storage - src/lib/supabase.ts is unused dead code now,
# kept only until it's removed outright.
# Also accepted: S3_BUCKET, AWS_REGION / REGION, AWS_ACCESS_KEY / ACCESS_KEY,
# AWS_SECRET_KEY / SECRET_KEY (the AWS_* names above win if both are set).
AWS_S3_BUCKET=""
AWS_S3_REGION=""
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY are shared with SES
# below - only need to be set once.

# ─── Payment Providers ──────────────────────────────────────
# Paystack (used both for merchants' own store checkouts AND for
# platform subscription billing — merchants paying Prokip itself)
PAYSTACK_PUBLIC_KEY=""
PAYSTACK_SECRET_KEY=""
# Signing secret for Prokip's own Paystack webhook, used by
# /api/webhooks/paystack-billing to confirm subscription renewals,
# cancellations, and downgrades. Get this from the Paystack dashboard
# under Settings > API Keys & Webhooks, matching the webhook URL
# https://yourdomain.com/api/webhooks/paystack-billing.
# Without this set, only the very first subscription payment will be
# picked up (via the client-side redirect verification) — recurring
# renewals will NOT be tracked, since only the webhook handles those.
PAYSTACK_WEBHOOK_SECRET=""

# Flutterwave
FLW_PUBLIC_KEY=""
FLW_SECRET_KEY=""

# Monnify
MONNIFY_API_KEY=""
MONNIFY_SECRET_KEY=""
MONNIFY_CONTRACT_CODE=""

# ─── AI Providers (at least one required for AI features) ────
GROQ_API_KEY=""
GROQ_KEY_2=""
GROQ_KEY_3=""
GROQ_KEY_4=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_AI_KEY=""
# Used for AI image generation (Gemini's "Nano Banana" models) - a real
# generated image, not a stock photo. Falls back to Unsplash automatically
# if this is unset. Optional override for the model used:
# GOOGLE_AI_IMAGE_MODEL="gemini-3.1-flash-image"
DEEPSEEK_API_KEY=""

# ─── Unsplash (optional — enables real AI-generated site images) ──
# Get a free Access Key at https://unsplash.com/developers (create an
# app, use its "Access Key", not the Secret Key). Without this set,
# AI page/site generation silently falls back to a curated set of
# static stock photos instead of searching Unsplash live per keyword.
UNSPLASH_ACCESS_KEY=""

# ─── AI Sandbox (Daytona, self-hosted) ─────────────────────
# Point these at your own self-hosted Daytona control-plane server, not
# Daytona's cloud service. If unset, sandbox creation is skipped and the
# AI preview automatically falls back to the block-based renderer.
DAYTONA_API_URL="https://your-daytona-server.example.com/api"
DAYTONA_API_KEY=""

# ─── Email (AWS SES) ────────────────────────────────────────
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_SES_REGION="us-east-1"
SES_FROM_EMAIL="noreply@yourdomain.com"
SES_FROM_NAME="Prokip"

# ─── Scheduled Jobs (cron) ───────────────────────────────────
# Two background jobs — campaign sending and abandoned-cart recovery —
# are defined in vercel.json as Vercel Crons. That file is Vercel-only
# config; on any other host (including Huawei Cloud) it does nothing, so
# these two endpoints need an external scheduler (a system crontab entry,
# or Huawei Cloud's own Timer/Cron service) hitting them on a schedule:
#   GET /api/cron/send-campaigns    (was daily on Vercel)
#   GET /api/cron/abandoned-carts   (was daily on Vercel)
# Both accept "Authorization: Bearer <CRON_SECRET>" for manual/external
# triggering — set this to any random secret and use it in your scheduler.
# Note: the "once daily" schedule above was a Vercel Hobby-plan cron
# limit, not a real requirement — once you're triggering these yourself,
# you can run them more often (e.g. every 15 min) for tighter timing.
CRON_SECRET=""

# ─── Custom Domains ─────────────────────────────────────────
CNAME_TARGET=""
NEXT_PUBLIC_CNAME_TARGET=""
SERVER_IP=""
NEXT_PUBLIC_SERVER_IP=""

# ─── Redis (Upstash — optional, enables caching) ────────────
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# ─── Sentry (optional, enables error tracking) ──────────────
# NEXT_PUBLIC_SENTRY_DSN=""
# SENTRY_DSN=""
# SENTRY_AUTH_TOKEN=""
# SENTRY_ORG=""
# SENTRY_PROJECT=""

# ─── Inngest (optional, enables background jobs) ────────────
# INNGEST_EVENT_KEY=""
# INNGEST_SIGNING_KEY=""

# ─── Performance Monitoring (optional) ──────────────────────
# NEXT_PUBLIC_ANALYTICS_ENDPOINT=""

# ─── Testing ────────────────────────────────────────────────
# TEST_BASE_URL="http://localhost:3000"
