# ─── Database ────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres"

# ─── Authentication ──────────────────────────────────────────
JWT_SECRET="change-this-to-a-random-secret"

# ─── App URLs ────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL="https://yourdomain.com"
NEXT_PUBLIC_APP_DOMAIN="yourdomain.com"
NEXT_PUBLIC_API_URL="https://yourdomain.com"

# ─── Supabase (Storage & Auth) ───────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# ─── Payment Providers ──────────────────────────────────────
# Paystack
PAYSTACK_PUBLIC_KEY=""
PAYSTACK_SECRET_KEY=""

# Flutterwave
FLW_PUBLIC_KEY=""
FLW_SECRET_KEY=""

# Monnify
MONNIFY_API_KEY=""
MONNIFY_SECRET_KEY=""
MONNIFY_CONTRACT_CODE=""

# ─── AI Providers (at least one required for AI features) ────
GROQ_API_KEY=""
GROQ_KEY_2=""
GROQ_KEY_3=""
GROQ_KEY_4=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_AI_KEY=""
DEEPSEEK_API_KEY=""

# ─── Email (AWS SES) ────────────────────────────────────────
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_SES_REGION="us-east-1"
SES_FROM_EMAIL="noreply@yourdomain.com"
SES_FROM_NAME="AfroStore"

# ─── Custom Domains ─────────────────────────────────────────
CNAME_TARGET=""
NEXT_PUBLIC_CNAME_TARGET=""
SERVER_IP=""
NEXT_PUBLIC_SERVER_IP=""

# ─── Redis (Upstash — optional, enables caching) ────────────
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# ─── Sentry (optional, enables error tracking) ──────────────
# NEXT_PUBLIC_SENTRY_DSN=""
# SENTRY_DSN=""
# SENTRY_AUTH_TOKEN=""
# SENTRY_ORG=""
# SENTRY_PROJECT=""

# ─── Inngest (optional, enables background jobs) ────────────
# INNGEST_EVENT_KEY=""
# INNGEST_SIGNING_KEY=""

# ─── Vercel Domain Management (optional, auto SSL) ──────────
# VERCEL_PROJECT_ID=""
# VERCEL_TEAM_ID=""
# VERCEL_AUTH_TOKEN=""

# ─── Performance Monitoring (optional) ──────────────────────
# NEXT_PUBLIC_ANALYTICS_ENDPOINT=""

# ─── Testing ────────────────────────────────────────────────
# TEST_BASE_URL="http://localhost:3000"
