  @@map("funnels")
}

model FunnelStep {
  id          String   @id @default(cuid())
  funnelId    String
  name        String
  type        FunnelStepType @default(LANDING)
  pageContent Json?    // builder blocks
  position    Int      @default(0)
  settings    Json?    // redirect, delay, conditions
