  category    String?
  tags        String[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  theme  Theme?  @relation(fields: [themeId], references: [id], onDelete: SetNull)
  plugin Plugin? @relation(fields: [pluginId], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([authorId])
  @@index([status])
  @@map("marketplace_items")
}

enum MarketplaceItemType {
  THEME
  PLUGIN
  TEMPLATE
  FUNNEL
  AUTOMATION
}

enum MarketplaceStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

// ─── ANALYTICS ──────────────────────────────────────────────

model AnalyticsEvent {
  id         String   @id @default(cuid())
  siteId     String
  event      String
  page       String?
  productId  String?
  orderId    String?
  funnelId   String?
  campaignId String?
  sessionId  String?
  source     String?
  medium     String?
  campaign   String?
  device     String?
  browser    String?
  os         String?
  country    String?
  city       String?
  metadata   Json?
  createdAt  DateTime @default(now())

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, event])
  @@index([siteId, createdAt])
  @@index([sessionId])
  @@index([siteId, funnelId])
  @@index([siteId, campaignId])
  @@map("analytics_events")
}

// ─── FLASH SALES ────────────────────────────────────────────

model FlashSale {
  id           String       @id @default(cuid())
  siteId       String
  name         String
  description  String?      @db.Text
  discountType DiscountType @default(PERCENTAGE)
  discountValue Float
  startsAt     DateTime
  endsAt       DateTime
  isActive     Boolean      @default(true)
  maxUses      Int?
  usedCount    Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  site     Site              @relation(fields: [siteId], references: [id], onDelete: Cascade)
  products FlashSaleProduct[]

  @@index([siteId])
  @@index([siteId, startsAt, endsAt])
  @@map("flash_sales")
}

model FlashSaleProduct {
  id               String @id @default(cuid())
  flashSaleId      String
  productId        String
  overrideDiscount Float?

  flashSale FlashSale @relation(fields: [flashSaleId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([flashSaleId, productId])
  @@map("flash_sale_products")
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

// ─── ABANDONED CARTS ────────────────────────────────────────

model AbandonedCart {
  id               String              @id @default(cuid())
  siteId           String
  customerId       String?
  email            String?
  phone            String?
  sessionId        String?
  items            Json
  totalAmount      Float               @default(0)
  currency         String              @default("NGN")
  status           AbandonedCartStatus  @default(ACTIVE)
  recoveredOrderId String?             @unique
  remindersSent    Int                 @default(0)
  lastReminderAt   DateTime?
  recoveredAt      DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  site           Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  customer       Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  recoveredOrder Order?    @relation("RecoveredCart", fields: [recoveredOrderId], references: [id], onDelete: SetNull)

  @@index([siteId, status])
  @@index([siteId, createdAt])
  @@index([email])
  @@map("abandoned_carts")
}

enum AbandonedCartStatus {
  ACTIVE
  REMINDED
  RECOVERED
  EXPIRED
}

// ─── LOYALTY POINTS ─────────────────────────────────────────

model LoyaltyProgram {
  id                String   @id @default(cuid())
  siteId            String   @unique
  enabled           Boolean  @default(true)
  pointsPerCurrency Float    @default(1)
  currencyPerPoint  Float    @default(100)
  redemptionRate    Float    @default(0.01)
  minRedeemPoints   Int      @default(100)
  welcomePoints     Int      @default(0)
  referralPoints    Int      @default(50)
  reviewPoints      Int      @default(10)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  site    Site           @relation(fields: [siteId], references: [id], onDelete: Cascade)
  members LoyaltyMember[]

  @@map("loyalty_programs")
}

model LoyaltyMember {
  id              String   @id @default(cuid())
  programId       String
  customerId      String
  totalPoints     Int      @default(0)
  availablePoints Int      @default(0)
  redeemedPoints  Int      @default(0)
  tier            String   @default("bronze")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  program      LoyaltyProgram     @relation(fields: [programId], references: [id], onDelete: Cascade)
  customer     Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  transactions LoyaltyTransaction[]

  @@unique([programId, customerId])
  @@map("loyalty_members")
}

model LoyaltyTransaction {
  id          String   @id @default(cuid())
  memberId    String
  type        String   // earn, redeem, bonus, expire
  points      Int
  description String?
  orderId     String?
  createdAt   DateTime @default(now())

  member LoyaltyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@map("loyalty_transactions")
}

// ─── REFERRAL / AFFILIATE ───────────────────────────────────

model ReferralProgram {
  id              String         @id @default(cuid())
  siteId          String         @unique
  enabled         Boolean        @default(true)
  commissionType  CommissionType @default(PERCENTAGE)
  commissionValue Float          @default(10)
  cookieDays      Int            @default(30)
  minPayoutAmount Float          @default(5000)
  autoApprove     Boolean        @default(false)
  welcomeMessage  String?        @db.Text
  termsText       String?        @db.Text
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  site       Site        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  affiliates Affiliate[]

  @@map("referral_programs")
}

model Affiliate {
  id              String          @id @default(cuid())
  programId       String
  customerId      String
  code            String          @unique
  status          AffiliateStatus @default(PENDING)
  totalClicks     Int             @default(0)
  totalOrders     Int             @default(0)
  totalEarnings   Float           @default(0)
  pendingEarnings Float           @default(0)
  paidEarnings    Float           @default(0)
  payoutMethod    String?
  payoutDetails   Json?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  program   ReferralProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  customer  Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  referrals Referral[]
  payouts   Payout[]

  @@unique([programId, customerId])
  @@index([code])
  @@map("affiliates")
}

model Referral {
  id               String         @id @default(cuid())
  affiliateId      String
  orderId          String?        @unique
  status           ReferralStatus @default(PENDING)
  commissionAmount Float          @default(0)
  clickedAt        DateTime       @default(now())
  convertedAt      DateTime?
  approvedAt       DateTime?
  ip               String?
  userAgent        String?

  affiliate Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  order     Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([affiliateId])
  @@map("referrals")
}

model Payout {
  id          String       @id @default(cuid())
  affiliateId String
  amount      Float
  status      PayoutStatus @default(PENDING)
  reference   String?
  paidAt      DateTime?
  note        String?
  createdAt   DateTime     @default(now())

  affiliate Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@index([affiliateId])
  @@map("payouts")
}

enum CommissionType {
  PERCENTAGE
  FLAT
}

enum AffiliateStatus {
  PENDING
  APPROVED
  SUSPENDED
  REJECTED
}

enum ReferralStatus {
  PENDING
  CONVERTED
  APPROVED
  REJECTED
  EXPIRED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// ─── CONTACT MESSAGES ───────────────────────────────────────

model ContactMessage {
