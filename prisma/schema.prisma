generator client {
  provider   = "prisma-client-js"
  output     = "../src/generated/prisma"
  engineType = "wasm"
}

datasource db {
  provider = "postgresql"
}

// ─── AUTH ────────────────────────────────────────────────────

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  emailVerified  DateTime?
  passwordHash   String?
  firstName      String
  lastName       String
  phone          String?
  avatar         String?
  role           UserRole  @default(MERCHANT)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  workspaces     Workspace[]
  workspaceMembers WorkspaceMember[]
  siteMembers    SiteMember[]
  notifications  Notification[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

enum UserRole {
  MERCHANT
  ADMIN
  SUPER_ADMIN
}

// ─── WORKSPACE ──────────────────────────────────────────────

model Workspace {
  id          String   @id @default(cuid())
  ownerId     String
  name        String
  slug        String   @unique
  logo        String?
  plan        WorkspacePlan @default(FREE)
  status      WorkspaceStatus @default(ACTIVE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members     WorkspaceMember[]
  sites       Site[]

  @@index([ownerId])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String          @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole   @default(EDITOR)
  createdAt   DateTime        @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@map("workspace_members")
}

enum WorkspacePlan {
  FREE
  STARTER
  BUSINESS
  GROWTH
  AGENCY
  ENTERPRISE
}

enum WorkspaceStatus {
  ACTIVE
  PAUSED
  SUSPENDED
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MANAGER
  EDITOR
  MARKETER
  SUPPORT
  DEVELOPER
  VIEWER
}

// ─── SITES (MULTI-TYPE) ─────────────────────────────────────

model Site {
  id             String      @id @default(cuid())
  workspaceId    String
  name           String
  slug           String      @unique
  description    String?     @db.Text
  logo           String?
  coverImage     String?
  siteType       SiteType    @default(ECOMMERCE)
  subdomain      String      @unique
  customDomain   String?     @unique
  currency       String      @default("NGN")
  country        String      @default("NG")
  businessType   String      @default("general")
  industry       String?
  status         SiteStatus  @default(ACTIVE)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  workspace      Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members        SiteMember[]
  products       Product[]
  categories     Category[]
  brands         Brand[]
  orders         Order[]
  customers      Customer[]
  coupons        Coupon[]
  pages          Page[]
  blogs          Blog[]
  forms          Form[]
  media          MediaItem[]
  themes         SiteTheme[]
  plugins        SitePlugin[]
  paymentGateways PaymentGateway[]
  deliveryZones  DeliveryZone[]
  taxRules       TaxRule[]
  domains        Domain[]
  settings       SiteSettings?
  socialLinks    SiteSocialLinks?
  analytics      AnalyticsEvent[]
  auditLogs      AuditLog[]
  contactMessages ContactMessage[]
  referralProgram ReferralProgram?
  flashSales     FlashSale[]
  abandonedCarts AbandonedCart[]
  loyaltyProgram LoyaltyProgram?
  wishlists      Wishlist[]
  funnels        Funnel[]
  crmContacts    CrmContact[]
  emailCampaigns EmailCampaign[]
  smsCampaigns   SmsCampaign[]
  whatsappCampaigns WhatsAppCampaign[]
  automations    Automation[]
  abTests        ABTest[]
  popups         Popup[]
  notifications  SiteNotification[]
  returns        Return[]

  @@index([workspaceId])
  @@index([subdomain])
  @@index([customDomain])
  @@index([siteType])
  @@map("sites")
}

model SiteMember {
  id        String          @id @default(cuid())
  siteId    String
  userId    String
  role      SiteMemberRole  @default(STAFF)
  createdAt DateTime        @default(now())

  site  Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user  User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([siteId, userId])
  @@map("site_members")
}

model SiteSettings {
  id                  String  @id @default(cuid())
  siteId              String  @unique
  allowGuestCheckout  Boolean @default(true)
  payOnDelivery       Boolean @default(true)
  bankTransfer        Boolean @default(true)
  whatsappOrdering    Boolean @default(true)
  showStockCount      Boolean @default(false)
  lowDataMode         Boolean @default(false)
  offlineMode         Boolean @default(false)
  language            String  @default("en")
  whatsappNumber      String?
  metaTitle           String?
  metaDescription     String? @db.Text
  googleAnalyticsId   String?
  facebookPixelId     String?
  tiktokPixelId       String?
  customHeadCode      String? @db.Text
  customBodyCode      String? @db.Text

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@map("site_settings")
}

model SiteSocialLinks {
  id        String  @id @default(cuid())
  siteId    String  @unique
  whatsapp  String?
  instagram String?
  facebook  String?
  twitter   String?
  tiktok    String?
  linkedin  String?
  youtube   String?

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@map("site_social_links")
}

enum SiteType {
  ECOMMERCE
  WEBSITE
  LANDING_PAGE
}

enum SiteStatus {
  ACTIVE
  PAUSED
  SUSPENDED
}

enum SiteMemberRole {
  OWNER
  ADMIN
  MANAGER
  EDITOR
  MARKETER
  SUPPORT
  DEVELOPER
  STAFF
  VIEWER
}

// ─── DOMAINS ────────────────────────────────────────────────

model Domain {
  id            String       @id @default(cuid())
  siteId        String
  domain        String       @unique
  type          DomainType   @default(CUSTOM)
  status        DomainStatus @default(PENDING)
  sslStatus     SSLStatus    @default(PENDING)
  sslExpiresAt  DateTime?
  dnsVerified   Boolean      @default(false)
  verificationToken String?
  isPrimary     Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
  @@map("domains")
}

enum DomainType {
  SUBDOMAIN
  CUSTOM
  FOLDER
}

enum DomainStatus {
  PENDING
  ACTIVE
  FAILED
  EXPIRED
}

enum SSLStatus {
  PENDING
  ACTIVE
  EXPIRED
  FAILED
}

// ─── PRODUCTS ───────────────────────────────────────────────

model Brand {
  id          String    @id @default(cuid())
  siteId      String
  name        String
  slug        String
  logo        String?
  description String?   @db.Text
  website     String?
  position    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  site     Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([siteId, slug])
  @@index([siteId])
  @@map("brands")
}

model Category {
  id          String    @id @default(cuid())
  siteId      String
  name        String
  slug        String
  description String?   @db.Text
  image       String?
  parentId    String?
  position    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  site     Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@unique([siteId, slug])
  @@index([siteId])
  @@map("categories")
}

model Product {
  id              String        @id @default(cuid())
  siteId          String
  categoryId      String?
  brandId         String?
  name            String
  slug            String
  description     String?       @db.Text
  price           Decimal       @db.Decimal(12, 2)
  compareAtPrice  Decimal?      @db.Decimal(12, 2)
  costPrice       Decimal?      @db.Decimal(12, 2)
  currency        String        @default("NGN")
  sku             String?
  barcode         String?
  stock           Int           @default(0)
  lowStockAlert   Int           @default(5)
  trackInventory  Boolean       @default(true)
  weight          Decimal?      @db.Decimal(8, 2)
  productType     ProductType   @default(PHYSICAL)
  status          ProductStatus @default(DRAFT)
  isFeatured      Boolean       @default(false)
  tags            String[]
  metaTitle       String?
  metaDescription String?       @db.Text
  position        Int           @default(0)
  // Digital product fields
  downloadUrl     String?
  downloadLimit   Int?
  // Subscription fields
  recurringInterval String?     // daily, weekly, monthly, yearly
  recurringPrice    Decimal?    @db.Decimal(12, 2)
  trialDays         Int?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  site       Site             @relation(fields: [siteId], references: [id], onDelete: Cascade)
  category   Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand      Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  images     ProductImage[]
  variants   ProductVariant[]
  orderItems OrderItem[]
  reviews    Review[]
  flashSales FlashSaleProduct[]
  wishlists  WishlistItem[]

  @@unique([siteId, slug])
  @@index([siteId])
  @@index([siteId, status])
  @@index([siteId, categoryId])
  @@index([siteId, brandId])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  position  Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  name      String
  sku       String?
  price     Decimal? @db.Decimal(12, 2)
  stock     Int      @default(0)
  image     String?
  options   Json
  position  Int      @default(0)
  createdAt DateTime @default(now())

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

enum ProductType {
  PHYSICAL
  DIGITAL
  SUBSCRIPTION
  SERVICE
}

enum ProductStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

// ─── ORDERS ─────────────────────────────────────────────────

model Order {
  id               String        @id @default(cuid())
  siteId           String
  customerId       String?
  orderNumber      String        @unique
  email            String
  phone            String?
  status           OrderStatus   @default(PENDING)
  paymentStatus    PaymentStatus @default(PENDING)
  paymentMethod    String?
  paymentReference String?
  subtotal         Decimal       @db.Decimal(12, 2)
  deliveryFee      Decimal       @default(0) @db.Decimal(12, 2)
  discount         Decimal       @default(0) @db.Decimal(12, 2)
  tax              Decimal       @default(0) @db.Decimal(12, 2)
  total            Decimal       @db.Decimal(12, 2)
  currency         String        @default("NGN")
  couponId         String?
  note             String?       @db.Text
  deliveryAddress  Json?
  deliveryMethod   String?
  deliveryZoneId   String?
  trackingNumber   String?
  whatsappNotified Boolean       @default(false)
  cancelReason     String?
  paidAt           DateTime?
  shippedAt        DateTime?
  deliveredAt      DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  site     Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  customer Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  coupon   Coupon?    @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items    OrderItem[]
  timeline OrderTimeline[]
  referral Referral?
  recoveredCart AbandonedCart? @relation("RecoveredCart")
  returns  Return[]

  @@index([siteId])
  @@index([siteId, status])
  @@index([siteId, createdAt])
  @@index([customerId])
  @@index([orderNumber])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  productId   String?
  variantId   String?
  name        String
  variantName String?
  sku         String?
  price       Decimal  @db.Decimal(12, 2)
  quantity    Int
  total       Decimal  @db.Decimal(12, 2)
  image       String?

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}

model OrderTimeline {
  id        String   @id @default(cuid())
  orderId   String
  status    String
  note      String?
  createdBy String?
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_timeline")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

// ─── RETURNS ────────────────────────────────────────────────

model Return {
  id            String       @id @default(cuid())
  siteId        String
  orderId       String
  reason        String       @db.Text
  status        ReturnStatus @default(REQUESTED)
  refundAmount  Decimal?     @db.Decimal(12, 2)
  refundMethod  String?
  items         Json?        // which items are being returned
  notes         String?      @db.Text
  resolvedAt    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  site  Site  @relation(fields: [siteId], references: [id], onDelete: Cascade)
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([siteId])
  @@index([orderId])
  @@map("returns")
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  REFUNDED
  CLOSED
}

// ─── CUSTOMERS ──────────────────────────────────────────────

model Customer {
  id          String   @id @default(cuid())
  siteId      String
  email       String
  firstName   String
  lastName    String
  phone       String?
  address     Json?
  tags        String[]
  note        String?  @db.Text
  totalOrders Int      @default(0)
  totalSpent  Decimal  @default(0) @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  site           Site            @relation(fields: [siteId], references: [id], onDelete: Cascade)
  orders         Order[]
  reviews        Review[]
  affiliates     Affiliate[]
  abandonedCarts AbandonedCart[]
  loyaltyMemberships LoyaltyMember[]
  wishlists      Wishlist[]

  @@unique([siteId, email])
  @@index([siteId])
  @@map("customers")
}

// ─── WISHLISTS ──────────────────────────────────────────────

model Wishlist {
  id         String   @id @default(cuid())
  siteId     String
  customerId String
  sessionId  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  site     Site           @relation(fields: [siteId], references: [id], onDelete: Cascade)
  customer Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items    WishlistItem[]

  @@unique([siteId, customerId])
  @@map("wishlists")
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  productId  String
  addedAt    DateTime @default(now())

  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId])
  @@map("wishlist_items")
}

// ─── REVIEWS ────────────────────────────────────────────────

model Review {
  id         String   @id @default(cuid())
  productId  String
  customerId String?
  name       String
  email      String
  rating     Int
  title      String?
  body       String?  @db.Text
  images     String[]
  isVerified Boolean  @default(false)
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())

  product  Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@map("reviews")
}

// ─── COUPONS ────────────────────────────────────────────────

model Coupon {
  id             String     @id @default(cuid())
  siteId         String
  code           String
  type           CouponType
  value          Decimal    @db.Decimal(12, 2)
  minOrderAmount Decimal?   @db.Decimal(12, 2)
  maxUses        Int?
  usedCount      Int        @default(0)
  startsAt       DateTime?
  expiresAt      DateTime?
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())

  site   Site    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  orders Order[]

  @@unique([siteId, code])
  @@index([siteId])
  @@map("coupons")
}

enum CouponType {
  PERCENTAGE
  FIXED
  FREE_SHIPPING
}

// ─── TAXES ──────────────────────────────────────────────────

model TaxRule {
  id          String   @id @default(cuid())
  siteId      String
  name        String
  rate        Decimal  @db.Decimal(5, 2) // percentage
  country     String?
  state       String?
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
  @@map("tax_rules")
}

// ─── PAYMENTS ───────────────────────────────────────────────

model PaymentGateway {
  id            String                @id @default(cuid())
  siteId        String
  provider      PaymentProvider
  isEnabled     Boolean               @default(false)
  publicKey     String?
  secretKey     String?
  webhookSecret String?
  config        Json?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  site         Site                   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  transactions PaymentTransaction[]

  @@unique([siteId, provider])
  @@index([siteId])
  @@map("payment_gateways")
}

model PaymentTransaction {
  id               String            @id @default(cuid())
  gatewayId        String
  orderId          String?
  reference        String            @unique
  externalRef      String?
  amount           Decimal           @db.Decimal(12, 2)
  currency         String            @default("NGN")
  status           TransactionStatus @default(PENDING)
  method           String?
  metadata         Json?
  paidAt           DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  gateway PaymentGateway @relation(fields: [gatewayId], references: [id], onDelete: Cascade)

  @@index([gatewayId])
  @@index([reference])
  @@index([orderId])
  @@map("payment_transactions")
}

enum PaymentProvider {
  MONNIFY
  PAYSTACK
  FLUTTERWAVE
  STRIPE
  PAYPAL
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  REVERSED
}

// ─── DELIVERY ───────────────────────────────────────────────

model DeliveryZone {
  id            String   @id @default(cuid())
  siteId        String
  name          String
  areas         String[]
  fee           Decimal  @db.Decimal(12, 2)
  freeAbove     Decimal? @db.Decimal(12, 2)
  estimatedDays String?
  isActive      Boolean  @default(true)
  position      Int      @default(0)
  createdAt     DateTime @default(now())

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
  @@map("delivery_zones")
}

// ─── THEMES ─────────────────────────────────────────────────

model Theme {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?   @db.Text
  thumbnail   String?
  preview     String?
  category    String    // ecommerce, website, landing_page
  industry    String?
  isPremium   Boolean   @default(false)
  isFeatured  Boolean   @default(false)
  isActive    Boolean   @default(true)
  config      Json      // colors, fonts, layout
  version     String    @default("1.0.0")
  tags        String[]
  installs    Int       @default(0)
  rating      Decimal   @default(0) @db.Decimal(3, 2)
  price       Decimal?  @db.Decimal(12, 2)
  authorId    String?
  isAIGenerated Boolean @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  siteThemes  SiteTheme[]
  marketplace MarketplaceItem[]

  @@map("themes")
}

model SiteTheme {
  id           String   @id @default(cuid())
  siteId       String
  themeId      String
  isActive     Boolean  @default(false)
  customConfig Json?
  installedAt  DateTime @default(now())

  site  Site  @relation(fields: [siteId], references: [id], onDelete: Cascade)
  theme Theme @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@unique([siteId, themeId])
  @@index([siteId])
  @@map("site_themes")
}

// ─── PLUGINS ────────────────────────────────────────────────

model Plugin {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String? @db.Text
  icon        String?
  category    String
  author      String
  version     String  @default("1.0.0")
  isPremium   Boolean @default(false)
  isActive    Boolean @default(true)
  config      Json?
  entryPoint  String?
  permissions String[]
  installs    Int     @default(0)
  rating      Decimal @default(0) @db.Decimal(3, 2)
  price       Decimal? @db.Decimal(12, 2)
  isAIGenerated Boolean @default(false)
  reviewStatus PluginReviewStatus @default(APPROVED)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sitePlugins SitePlugin[]
  marketplace MarketplaceItem[]

  @@map("plugins")
}

model SitePlugin {
  id          String   @id @default(cuid())
  siteId      String
  pluginId    String
  isEnabled   Boolean  @default(true)
  config      Json?
  settings    Json?
  installedAt DateTime @default(now())

  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  plugin Plugin @relation(fields: [pluginId], references: [id], onDelete: Cascade)

  @@unique([siteId, pluginId])
  @@index([siteId])
  @@map("site_plugins")
}

enum PluginReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─── PAGES (BUILDER) ────────────────────────────────────────

model Page {
  id              String     @id @default(cuid())
  siteId          String
  title           String
  slug            String
  type            PageType   @default(CUSTOM)
  content         Json?      // builder blocks
  metaTitle       String?
  metaDescription String?    @db.Text
  isPublished     Boolean    @default(false)
  position        Int        @default(0)
  template        String?    // template slug if from template
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  site    Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  abTests ABTest[]

  @@unique([siteId, slug])
  @@index([siteId])
  @@map("pages")
}

enum PageType {
  HOME
  ABOUT
  CONTACT
  FAQ
  POLICY
  CUSTOM
  LANDING
  SERVICES
  TEAM
  KNOWLEDGE_BASE
  THANK_YOU
}

// ─── BLOGS ──────────────────────────────────────────────────

model Blog {
  id          String     @id @default(cuid())
  siteId      String
  title       String
  slug        String
  excerpt     String?    @db.Text
  content     Json?      // rich content blocks
  contentHtml String?    @db.Text
  coverImage  String?
  author      String?
  category    String?
  tags        String[]
  status      BlogStatus @default(DRAFT)
  metaTitle   String?
  metaDescription String? @db.Text
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, slug])
  @@index([siteId])
  @@index([siteId, status])
  @@map("blogs")
}

enum BlogStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// ─── FORMS ──────────────────────────────────────────────────

model Form {
  id             String   @id @default(cuid())
  siteId         String
  name           String
  slug           String
  description    String?  @db.Text
  fields         Json     // form field definitions
  settings       Json?    // redirect url, email notifications, etc.
  submitButtonText String @default("Submit")
  successMessage String?  @db.Text
  isActive       Boolean  @default(true)
  submissionCount Int     @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  site        Site             @relation(fields: [siteId], references: [id], onDelete: Cascade)
