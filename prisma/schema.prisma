generator client {
  provider   = "prisma-client-js"
  output     = "../src/generated/prisma"
  engineType = "wasm"
}

datasource db {
  provider = "postgresql"
}

// ─── AUTH ────────────────────────────────────────────────────

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  emailVerified  DateTime?
  passwordHash   String?
  firstName      String
  lastName       String
  phone          String?
  avatar         String?
  role           UserRole  @default(MERCHANT)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  stores         Store[]
  storeMembers   StoreMember[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

enum UserRole {
  MERCHANT
  ADMIN
  SUPER_ADMIN
}

// ─── STORES (MULTI-TENANT) ──────────────────────────────────

model Store {
  id             String      @id @default(cuid())
  ownerId        String
  name           String
  slug           String      @unique
  description    String?     @db.Text
  logo           String?
  coverImage     String?
  subdomain      String      @unique
  customDomain   String?     @unique
  currency       String      @default("NGN")
  country        String      @default("NG")
  businessType   String      @default("general")
  status         StoreStatus @default(ACTIVE)
  plan           StorePlan   @default(FREE)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  owner          User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members        StoreMember[]
  products       Product[]
  categories     Category[]
  orders         Order[]
  customers      Customer[]
  coupons        Coupon[]
  pages          Page[]
  themes         StoreTheme[]
  plugins        StorePlugin[]
  paymentGateways PaymentGateway[]
  deliveryZones  DeliveryZone[]
  settings       StoreSettings?
  socialLinks    StoreSocialLinks?
  analytics      AnalyticsEvent[]
  auditLogs      AuditLog[]
  referralProgram ReferralProgram?

  @@index([ownerId])
  @@index([subdomain])
  @@index([customDomain])
  @@map("stores")
}

model StoreMember {
  id        String          @id @default(cuid())
  storeId   String
  userId    String
  role      StoreMemberRole @default(STAFF)
  createdAt DateTime        @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storeId, userId])
  @@map("store_members")
}

model StoreSettings {
  id                  String  @id @default(cuid())
  storeId             String  @unique
  allowGuestCheckout  Boolean @default(true)
  payOnDelivery       Boolean @default(true)
  bankTransfer        Boolean @default(true)
  whatsappOrdering    Boolean @default(true)
  showStockCount      Boolean @default(false)
  lowDataMode         Boolean @default(false)
  language            String  @default("en")
  whatsappNumber      String?
  metaTitle           String?
  metaDescription     String? @db.Text
  googleAnalyticsId   String?
  facebookPixelId     String?
  tiktokPixelId       String?

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("store_settings")
}

model StoreSocialLinks {
  id        String  @id @default(cuid())
  storeId   String  @unique
  whatsapp  String?
  instagram String?
  facebook  String?
  twitter   String?
  tiktok    String?

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("store_social_links")
}

enum StoreStatus {
  ACTIVE
  PAUSED
  SUSPENDED
}

enum StorePlan {
  FREE
  STARTER
  BUSINESS
  GROWTH
  AGENCY
  ENTERPRISE
}

enum StoreMemberRole {
  OWNER
  ADMIN
  STAFF
  VIEWER
}

// ─── PRODUCTS ───────────────────────────────────────────────

model Category {
  id          String    @id @default(cuid())
  storeId     String
  name        String
  slug        String
  description String?   @db.Text
  image       String?
  parentId    String?
  position    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  store    Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@unique([storeId, slug])
  @@index([storeId])
  @@map("categories")
}

model Product {
  id             String        @id @default(cuid())
  storeId        String
  categoryId     String?
  name           String
  slug           String
  description    String?       @db.Text
  price          Decimal       @db.Decimal(12, 2)
  compareAtPrice Decimal?      @db.Decimal(12, 2)
  costPrice      Decimal?      @db.Decimal(12, 2)
  currency       String        @default("NGN")
  sku            String?
  barcode        String?
  stock          Int           @default(0)
  lowStockAlert  Int           @default(5)
  trackInventory Boolean       @default(true)
  weight         Decimal?      @db.Decimal(8, 2)
  status         ProductStatus @default(DRAFT)
  isFeatured     Boolean       @default(false)
  tags           String[]
  metaTitle      String?
  metaDescription String?      @db.Text
  position       Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  store     Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category  Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images    ProductImage[]
  variants  ProductVariant[]
  orderItems OrderItem[]
  reviews   Review[]

  @@unique([storeId, slug])
  @@index([storeId])
  @@index([storeId, status])
  @@index([storeId, categoryId])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  position  Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  name      String
  sku       String?
  price     Decimal? @db.Decimal(12, 2)
  stock     Int      @default(0)
  options   Json     // e.g. { "size": "M", "color": "Red" }
  position  Int      @default(0)
  createdAt DateTime @default(now())

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

enum ProductStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

// ─── ORDERS ─────────────────────────────────────────────────

model Order {
  id               String        @id @default(cuid())
  storeId          String
  customerId       String?
  orderNumber      String        @unique
  email            String
  phone            String?
  status           OrderStatus   @default(PENDING)
  paymentStatus    PaymentStatus @default(PENDING)
  paymentMethod    String?
  paymentReference String?
  subtotal         Decimal       @db.Decimal(12, 2)
  deliveryFee      Decimal       @default(0) @db.Decimal(12, 2)
  discount         Decimal       @default(0) @db.Decimal(12, 2)
  tax              Decimal       @default(0) @db.Decimal(12, 2)
  total            Decimal       @db.Decimal(12, 2)
  currency         String        @default("NGN")
  couponId         String?
  note             String?       @db.Text
  deliveryAddress  Json?
  deliveryMethod   String?
  deliveryZoneId   String?
  trackingNumber   String?
  whatsappNotified Boolean       @default(false)
  cancelReason     String?
  paidAt           DateTime?
  shippedAt        DateTime?
  deliveredAt      DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  store    Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  coupon   Coupon?    @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items    OrderItem[]
  timeline OrderTimeline[]
  referral Referral?

  @@index([storeId])
  @@index([storeId, status])
  @@index([storeId, createdAt])
  @@index([customerId])
  @@index([orderNumber])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  productId   String?
  variantId   String?
  name        String
  variantName String?
  sku         String?
  price       Decimal  @db.Decimal(12, 2)
  quantity    Int
  total       Decimal  @db.Decimal(12, 2)
  image       String?

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}

model OrderTimeline {
  id        String   @id @default(cuid())
  orderId   String
  status    String
  note      String?
  createdBy String?
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_timeline")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

// ─── CUSTOMERS ──────────────────────────────────────────────

model Customer {
  id          String   @id @default(cuid())
  storeId     String
  email       String
  firstName   String
  lastName    String
  phone       String?
  address     Json?
  tags        String[]
  note        String?  @db.Text
  totalOrders Int      @default(0)
  totalSpent  Decimal  @default(0) @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store      Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orders     Order[]
  reviews    Review[]
  affiliates Affiliate[]

  @@unique([storeId, email])
  @@index([storeId])
  @@map("customers")
}

// ─── REVIEWS ────────────────────────────────────────────────

model Review {
  id         String   @id @default(cuid())
  productId  String
  customerId String?
  name       String
  email      String
  rating     Int
  title      String?
  body       String?  @db.Text
  images     String[]
  isVerified Boolean  @default(false)
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())

  product  Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@map("reviews")
}

// ─── COUPONS ────────────────────────────────────────────────

model Coupon {
  id             String     @id @default(cuid())
  storeId        String
  code           String
  type           CouponType
  value          Decimal    @db.Decimal(12, 2)
  minOrderAmount Decimal?   @db.Decimal(12, 2)
  maxUses        Int?
  usedCount      Int        @default(0)
  startsAt       DateTime?
  expiresAt      DateTime?
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())

  store  Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orders Order[]

  @@unique([storeId, code])
  @@index([storeId])
  @@map("coupons")
}

enum CouponType {
  PERCENTAGE
  FIXED
  FREE_SHIPPING
}

// ─── PAYMENTS ───────────────────────────────────────────────

model PaymentGateway {
  id            String                @id @default(cuid())
  storeId       String
  provider      PaymentProvider
  isEnabled     Boolean               @default(false)
  publicKey     String?
  secretKey     String?
  webhookSecret String?
  config        Json?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  store        Store                  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  transactions PaymentTransaction[]

  @@unique([storeId, provider])
  @@index([storeId])
  @@map("payment_gateways")
}

model PaymentTransaction {
  id               String            @id @default(cuid())
  gatewayId        String
  orderId          String?
  reference        String            @unique
  externalRef      String?
  amount           Decimal           @db.Decimal(12, 2)
  currency         String            @default("NGN")
  status           TransactionStatus @default(PENDING)
  method           String?
  metadata         Json?
  paidAt           DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  gateway PaymentGateway @relation(fields: [gatewayId], references: [id], onDelete: Cascade)

  @@index([gatewayId])
  @@index([reference])
  @@index([orderId])
  @@map("payment_transactions")
}

enum PaymentProvider {
  MONNIFY
  PAYSTACK
  FLUTTERWAVE
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  REVERSED
}

// ─── DELIVERY ───────────────────────────────────────────────

model DeliveryZone {
  id            String   @id @default(cuid())
  storeId       String
  name          String
  areas         String[]
  fee           Decimal  @db.Decimal(12, 2)
  freeAbove     Decimal? @db.Decimal(12, 2)
  estimatedDays String?
  isActive      Boolean  @default(true)
  position      Int      @default(0)
  createdAt     DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@map("delivery_zones")
}

// ─── THEMES ─────────────────────────────────────────────────

model Theme {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String? @db.Text
  thumbnail   String?
  preview     String?
  category    String
  industry    String?
  isPremium   Boolean @default(false)
  isFeatured  Boolean @default(false)
  isActive    Boolean @default(true)
  config      Json    // colors, fonts, layout
  version     String  @default("1.0.0")
  tags        String[]
  installs    Int     @default(0)
  rating      Decimal @default(0) @db.Decimal(3, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  storeThemes StoreTheme[]

  @@map("themes")
}

model StoreTheme {
  id           String   @id @default(cuid())
  storeId      String
  themeId      String
  isActive     Boolean  @default(false)
  customConfig Json?    // overrides
  installedAt  DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  theme Theme @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@unique([storeId, themeId])
  @@index([storeId])
  @@map("store_themes")
}

// ─── PLUGINS ────────────────────────────────────────────────

model Plugin {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String? @db.Text
  icon        String?
  category    String
  author      String
  version     String  @default("1.0.0")
  isPremium   Boolean @default(false)
  isActive    Boolean @default(true)
  config      Json?
  entryPoint  String?
  permissions String[]
  installs    Int     @default(0)
  rating      Decimal @default(0) @db.Decimal(3, 2)
  isAIGenerated Boolean @default(false)
  reviewStatus PluginReviewStatus @default(APPROVED)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  storePlugins StorePlugin[]

  @@map("plugins")
}

model StorePlugin {
  id          String   @id @default(cuid())
  storeId     String
  pluginId    String
  isEnabled   Boolean  @default(true)
  config      Json?
  installedAt DateTime @default(now())

  store  Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  plugin Plugin @relation(fields: [pluginId], references: [id], onDelete: Cascade)

  @@unique([storeId, pluginId])
  @@index([storeId])
  @@map("store_plugins")
}

enum PluginReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─── PAGES (BUILDER) ────────────────────────────────────────

model Page {
  id          String     @id @default(cuid())
  storeId     String
  title       String
  slug        String
  type        PageType   @default(CUSTOM)
  content     Json?      // builder blocks
  metaTitle   String?
  metaDescription String? @db.Text
  isPublished Boolean    @default(false)
  position    Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, slug])
  @@index([storeId])
  @@map("pages")
}

enum PageType {
  HOME
  ABOUT
  CONTACT
  FAQ
  POLICY
  CUSTOM
  LANDING
}

// ─── ANALYTICS ──────────────────────────────────────────────

model AnalyticsEvent {
  id        String   @id @default(cuid())
  storeId   String
  event     String   // page_view, add_to_cart, checkout, purchase
  page      String?
  productId String?
  orderId   String?
  sessionId String?
  source    String?
  device    String?
  country   String?
  city      String?
  metadata  Json?
  createdAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, event])
  @@index([storeId, createdAt])
  @@index([sessionId])
  @@map("analytics_events")
}

// ─── REFERRAL / AFFILIATE ───────────────────────────────────

model ReferralProgram {
  id              String   @id @default(cuid())
  storeId         String   @unique
  enabled         Boolean  @default(true)
  commissionType  CommissionType @default(PERCENTAGE)
  commissionValue Float    @default(10) // 10% or flat amount
  cookieDays      Int      @default(30) // how long referral cookie lasts
  minPayoutAmount Float    @default(5000) // minimum before payout
  autoApprove     Boolean  @default(false) // auto-approve referrals on purchase
  welcomeMessage  String?  @db.Text
  termsText       String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  store      Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  affiliates Affiliate[]

  @@map("referral_programs")
}

model Affiliate {
  id              String          @id @default(cuid())
  programId       String
  customerId      String
  code            String          @unique // unique referral code
  status          AffiliateStatus @default(PENDING)
  totalClicks     Int             @default(0)
  totalOrders     Int             @default(0)
  totalEarnings   Float           @default(0)
  pendingEarnings Float           @default(0)
  paidEarnings    Float           @default(0)
  payoutMethod    String?         // bank_transfer, mobile_money, etc.
  payoutDetails   Json?           // bank name, account number, etc.
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  program    ReferralProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  customer   Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  referrals  Referral[]
  payouts    Payout[]

  @@unique([programId, customerId])
  @@index([code])
  @@map("affiliates")
}

model Referral {
  id            String         @id @default(cuid())
  affiliateId   String
  orderId       String?        @unique
  status        ReferralStatus @default(PENDING)
  commissionAmount Float       @default(0)
  clickedAt     DateTime       @default(now())
  convertedAt   DateTime?
  approvedAt    DateTime?
  ip            String?
  userAgent     String?

  affiliate Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  order     Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([affiliateId])
  @@map("referrals")
}

model Payout {
  id          String       @id @default(cuid())
  affiliateId String
  amount      Float
  status      PayoutStatus @default(PENDING)
  reference   String?      // payment reference
  paidAt      DateTime?
  note        String?
  createdAt   DateTime     @default(now())

  affiliate Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@index([affiliateId])
  @@map("payouts")
}

enum CommissionType {
  PERCENTAGE
  FLAT
}

enum AffiliateStatus {
  PENDING
  APPROVED
  SUSPENDED
  REJECTED
}

enum ReferralStatus {
  PENDING
  CONVERTED
  APPROVED
  REJECTED
  EXPIRED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// ─── AUDIT LOG ──────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  storeId   String
  userId    String?
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt])
  @@index([storeId, entity])
  @@map("audit_logs")
}
